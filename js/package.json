{
  "name": "ninada",
  "version": "4.0.2",
  "description": "Stream Classical Sanskrit and 5 Indian languages at 24 kHz studio quality in the browser and Node.js via dedicated ~28 MB Native Studio VITS ONNX specialists or zero-dep Klatt synthesis.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "src/index.d.ts",
  "bin": {
    "ninada": "bin/ninada.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "ninada",
    "sanskrit",
    "indic",
    "tts",
    "text-to-speech",
    "vits",
    "hifi-gan",
    "webml-kit",
    "webgpu",
    "wasm",
    "kannada",
    "tamil",
    "telugu",
    "malayalam",
    "hindi"
  ],
  "peerDependencies": {
    "webml-kit": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "webml-kit": {
      "optional": true
    }
  },
  "homepage": "https://hemanth.github.io/ninada/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemanth/ninada.git"
  },
  "bugs": {
    "url": "https://github.com/hemanth/ninada/issues"
  },
  "author": "Hemanth HM <hemanth@h3manth.com> (https://h3manth.com)",
  "license": "MIT"
}
